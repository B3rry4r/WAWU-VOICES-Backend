# /etc/voices/api.env on the droplet. NAMES only here; fill the values on the droplet, never in git.
NODE_ENV=production
PORT=4000
# Postgres URL; end it with &connection_limit=20 so parallel Voice Units transactions do not queue (see api/.env.example).
DATABASE_URL=
DATABASE_POOL_MAX=20
REDIS_URL=redis://127.0.0.1:6379
WAWU_ID_JWKS_URL=https://id.wawuafrica.com/.well-known/jwks.json
WAWU_ID_ISSUER=
WAWU_ID_AUDIENCE=
# SPACES_REGION is the region of the WAWU droplet (read it off the DigitalOcean page), e.g. nyc3.
# SPACES_ENDPOINT is https://<region>.digitaloceanspaces.com
SPACES_REGION=
SPACES_ENDPOINT=
SPACES_BUCKET=wawu-voices
SPACES_BACKUP_BUCKET=wawu-voices-backups
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_URL=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
GEMINI_API_KEY=

# Secret that keys the phone-number hash (HMAC-SHA256). Required in production: the API refuses to boot without it.
# Generate once with `openssl rand -hex 32`, keep it forever (changing it breaks one-account-per-phone and one-vote-per-phone).
VOICES_PHONE_PEPPER=
# Flutterwave secret key for Voice Units payments (server only; never in git or the browser).
FLW_SECRET_KEY=
# Flutterwave API base; leave empty for https://api.flutterwave.com/v3.
FLW_BASE_URL=
# Public address of the web app, where Flutterwave sends people back after paying (e.g. https://voices.wawuafrica.com).
APP_BASE_URL=
