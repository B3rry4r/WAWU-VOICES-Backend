# Copy to .env. Never commit .env.
NODE_ENV=development
PORT=4000
# connection_limit=20: more than the default so many parallel Voice Units transactions do not queue behind each other.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voices?schema=public&connection_limit=20
REDIS_URL=redis://localhost:6379
# WAWU ID (sign-in). RS256 access tokens verified against the JWKS.
WAWU_ID_JWKS_URL=https://id.wawuafrica.com/.well-known/jwks.json
# Optional: enforced when set.
WAWU_ID_JWT_ISSUER=
WAWU_ID_JWT_AUDIENCE=
# Comma list of allowed web origins. Required in production.
CORS_ORIGIN=http://localhost:3000
# Requests per minute per caller (global default).
THROTTLE_LIMIT=1200

# Secret that keys the phone-number hash (HMAC-SHA256). Required in production: the API refuses to boot without it.
# Generate once with `openssl rand -hex 32`, keep it forever (changing it breaks one-account-per-phone and one-vote-per-phone).
VOICES_PHONE_PEPPER=
# Flutterwave secret key for Voice Units payments (server only; never in git or the browser).
FLW_SECRET_KEY=
# Flutterwave API base; leave empty for https://api.flutterwave.com/v3.
FLW_BASE_URL=
# Public address of the web app, where Flutterwave sends people back after paying (e.g. https://usevoices.com).
APP_BASE_URL=https://usevoices.com
# Public address used in share links and cards (V-35). Defaults to https://usevoices.com.
PUBLIC_WEB_BASE=https://usevoices.com

# VOICES notification mail (V-44, M-b). Sent through WAWU ID's mail relay with the service key; unset = no mail.
# WAWU ID base URL (same service the JWKS comes from) and the shared internal service key.
WAWU_ID_BASE_URL=
INTERNAL_SERVICE_KEY=
# Optional: the folder the VOICES mail logos are fetched from (WAWU ID serves logo-wordmark-white.png and the others there). Default: <WAWU_ID_BASE_URL>/assets/voices
VOICES_MAIL_ASSET_URL=

# V-TOPIC-MAILS: the daily question (C01) and topic of the week (C02) emails. Default ON; set TOPIC_MAIL_ENABLED=false and restart to turn both off.
TOPIC_MAIL_ENABLED=true
# Lagos clock. C01 goes from DAILY_AT until DAILY_UNTIL (after that the day's mail is skipped for whoever was not reached); C02 goes from TOPIC_AT on the topic's days.
TOPIC_MAIL_DAILY_AT=07:00
TOPIC_MAIL_DAILY_UNTIL=12:00
TOPIC_MAIL_TOPIC_AT=06:30
# Mails per second to the relay.
TOPIC_MAIL_PER_SECOND=5
# Optional: the key the unsubscribe links are signed with (default: INTERNAL_SERVICE_KEY).
MAIL_UNSUBSCRIBE_SECRET=
# Most topic mails (C01 and C02 together) one UTC day may hold. WAWU ID's relay allows 5,000 a day for everyone, so this keeps receipts and reply notices from being starved.
TOPIC_MAIL_DAILY_MAX=2500

# V-SURVEYS: most mails to survey brand contacts (F01 to F04 together) one UTC day may hold. They share the relay with sign-in codes.
BRAND_MAIL_DAILY_MAX=50
