# /etc/voices/web.env on the droplet.
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-side calls (the share page, the /s middleware) reach the API here, not through nginx. Without it they use this same address.
VOICES_API_BASE=http://127.0.0.1:4000/api/v1
